# Set to "true" to use mock data for development
DEV_MODE=false

# Base URL of the official Foodcourt API deployment

# Passkey relying-party settings. Origins are comma-separated and must be
# HTTPS (HTTP is accepted only for an actual loopback host). PASSKEY_RP_ID must
# equal the hostname the browser shows, or be a parent domain of it — when
# running `vite dev` use PASSKEY_RP_ID=localhost and
# PASSKEY_ORIGINS=http://localhost:5173 instead of the deployed domain.
PASSKEY_RP_ID=cibus.example.edu
PASSKEY_RP_NAME=Cibus
PASSKEY_ORIGINS=https://cibus.example.edu

# The passkey and password-reauthentication transport is independently pinned
# so credentials are never sent over a legacy cleartext Foodcourt API link.
# `vite dev` additionally accepts a plain-HTTP base so a TLS-less LAN Tomcat can
# be used locally; production builds still require HTTPS or a loopback host.
PASSKEY_FOODCOURT_API_BASE_URL=https://foodcourt.example.edu/foodcourtapi

# Configure exactly one. Secret files are consumed as raw bytes, making this
# the recommended form for mounted/generated secrets (minimum 32 bytes).
PASSKEY_INTERNAL_SECRET_FILE=/run/secrets/cibus-passkey-internal
# PASSKEY_INTERNAL_SECRET=replace-with-at-least-32-random-characters

# Verification settings for JWTs issued by the Foodcourt JSP backend.
# The private signing key remains only in the JSP deployment under WEB-INF.
EATRIGHT_JWT_ALGORITHM=RS256
EATRIGHT_JWT_ISSUER=cibus-rdmw
EATRIGHT_JWT_AUDIENCE=cibus
EATRIGHT_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
