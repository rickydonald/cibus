# Use the in-memory Eat Right adapter during local development.
DEV_MODE=true

# Encrypts the HttpOnly session cookie. REQUIRED in production — the server
# refuses to start without it, because the cookie carries the user's upstream
# Eat Right credentials and a shared/known key would expose every account.
# Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-secret
